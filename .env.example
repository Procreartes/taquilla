# Taquilla · variables de entorno de ejemplo.
# Copia este fichero como .env y rellena lo que necesites. NUNCA subas el .env al repositorio.
# Sin DATABASE_URL ni REDIS_URL la API arranca en MODO DEMOSTRACIÓN (base de datos local PGlite + memoria).

# --- Básico ---
NODE_ENV=development
PORT=4000
URL_PUBLICA=http://localhost:3000
# Detrás de Cloudflare / Traefik en producción: TRUST_PROXY=true
TRUST_PROXY=

# --- Base de datos y Redis (modo completo / docker compose) ---
# DATABASE_URL=postgres://taquilla:taquilla@localhost:5432/taquilla
# REDIS_URL=redis://localhost:6379

# --- Secretos (en producción, cadenas largas y aleatorias: openssl rand -base64 48) ---
SECRETO_SESION=
SECRETO_QR=
SECRETO_DATOS=
SECRETO_PUERTA=
SECRETO_COLA=

# --- Usuarios de prueba (solo local) ---
# Contraseña de todos los usuarios de prueba (admin@taquilla.test, gerencia@asombra.test, puerta@taquilla.test…).
# En modo demostración también puedes entrar con el botón «Entrar como…» sin contraseña.
CLAVE_USUARIOS_PRUEBA=prueba-local-taquilla
# Obligar a todo el equipo a usar verificación en dos pasos (en producción: true)
EXIGIR_2FA=false

# --- Stripe (SOLO MODO PRUEBA: la API rechaza claves sk_live_) ---
# Sin clave se usa la pasarela simulada local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Correo ---
# Con docker compose: smtp://mailpit:1025 (o smtp://localhost:1025 si la API corre fuera de Docker).
# Sin SMTP_URL los correos se guardan en la base de datos y se ven en el panel («Correos de prueba»).
SMTP_URL=
CORREO_REMITENTE=Taquilla <no-responder@taquilla.test>

# --- Cloudflare Turnstile (anti-bots en la compra). Sin claves, la comprobación se omite en local. ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Microsoft 365 / Entra ID para el equipo interno (opcional) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Venta ---
RESERVA_MINUTOS=10
LIMITE_ENTRAR_POR_MINUTO=10
COLA_VIRTUAL_ACTIVA=false
COLA_PASES_POR_MINUTO=300
